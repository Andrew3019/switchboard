#!/usr/bin/env python3
"""MEASUREMENT ONLY. A PreToolUse/PostToolUse activity hook shaped exactly like the
existing Stop gate: read the payload, resolve the agent the way hooks._agent_row does,
write one event row. Never raises, always exit 0.

If SB_HOOK_LOG is set, appends "<event> <tool> <start_epoch> <ms_inside_python>" — used
to count firings and to separate the interpreter's own start-up from the work it does.
"""
import json
import os
import sys
import time

T_IN = time.time()
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), ".."))


def main() -> int:
    argv = sys.argv[1:]
    db_path = None
    kind = "tool_activity"
    if "--db" in argv:
        i = argv.index("--db")
        if i + 1 < len(argv):
            db_path = argv[i + 1]
    if "--kind" in argv:
        i = argv.index("--kind")
        if i + 1 < len(argv):
            kind = argv[i + 1]
    try:
        payload = json.loads(sys.stdin.read() or "{}")
    except Exception:
        payload = {}
    try:
        from switchboard import hooks, store
        db = store.connect(path=db_path)
        try:
            row = hooks._agent_row(db, payload)
            store.log_event(db, kind=kind, agent=row["name"] if row is not None else None,
                            tool=payload.get("tool_name"))
        finally:
            db.close()
    except Exception as e:  # noqa: BLE001
        print(f"sb-activity-hook: {e}", file=sys.stderr)
    log = os.environ.get("SB_HOOK_LOG")
    if log:
        with open(log, "a") as fh:
            fh.write(f"{payload.get('hook_event_name')} {payload.get('tool_name')} "
                     f"{T_IN:.4f} {(time.time() - T_IN) * 1000:.1f}\n")
    return 0


raise SystemExit(main())
