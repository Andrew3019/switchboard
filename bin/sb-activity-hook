#!/usr/bin/env python3
"""The UserPromptSubmit hook's entry point: a turn is starting. Always exit 0, print NOTHING.

Prints nothing on stdout, ever, and that is a hard rule rather than a style: the CLI adds a
`UserPromptSubmit` hook's stdout to the agent's context, so anything written here arrives in
front of the agent as though it were part of its task. Errors go to stderr.

Deliberately NOT a `sb` subcommand, for `bin/sb-stop-hook`'s reason: every `sb` invocation is
also a tick of the doorbell (`cli.main` calls `flush_pending`), and this runs at the exact
moment a turn is beginning — the ring it would fire is one it is about to defer anyway.
"""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), ".."))


def main() -> int:
    db = None
    argv = sys.argv[1:]
    if "--db" in argv:
        i = argv.index("--db")
        if i + 1 < len(argv):
            db = argv[i + 1]
    try:
        from switchboard import hooks
        hooks.run_activity(sys.stdin.read(), db_path=db)
    except Exception as e:                       # noqa: BLE001 — never trap an agent
        print(f"sb-activity-hook: {e}", file=sys.stderr)
    return 0


raise SystemExit(main())
